# Guide

@"@voxgig/apidef/model/guide.aontu"

@"./base-guide.aontu"


# Corrections to the heuristic classification.
#
# The Resend spec names most DELETE/PATCH responses per operation
# (RemoveContactResponseSuccess, UpdateTopicResponseSuccess, ...), and the
# heuristic made each of those an entity of its own. It also moved several
# collection paths (/templates, /topics, /segments, /suppressions, /webhooks)
# onto those per-operation entities. Below, every operation is folded back
# onto the resource it belongs to, and the invented entities are switched
# off (not dropped) so they stay visible in the model.


# --- Switched off: replaced by the corrections below ----------------------

guide: entity: add_contact_to_segment_response_success: active: false
guide: entity: automation_run_list_item: active: false
guide: entity: batch_add_suppressions_response_success: active: false
guide: entity: batch_remove_suppressions_response_success: active: false
guide: entity: contact_import_response_success: active: false
guide: entity: contact_topics_response_success: active: false
guide: entity: create_api_key: active: false
guide: entity: create_batch_email: active: false
guide: entity: create_broadcast_response_success: active: false
guide: entity: create_inbox_draft_response_success: active: false
guide: entity: create_inbox_label_response_success: active: false
guide: entity: inbox_agent_response_success: active: false
guide: entity: inbox_draft_list_item: active: false
guide: entity: inbox_draft_response_success: active: false
guide: entity: inbox_thread_email_response_success: active: false
guide: entity: inbox_thread_response_success: active: false
guide: entity: list_attachment: active: false
guide: entity: list_broadcast_clicked_links_response_success: active: false
guide: entity: list_broadcast_recipients_response_success: active: false
guide: entity: list_contact_segments_response_success: active: false
guide: entity: list_contacts_response_success: active: false
guide: entity: list_webhook_event: active: false
guide: entity: list_webhook_event_attempt: active: false
guide: entity: remove_audience_response_success: active: false
guide: entity: remove_broadcast_response_success: active: false
guide: entity: remove_contact_from_segment_response_success: active: false
guide: entity: remove_contact_property_response_success: active: false
guide: entity: remove_contact_response_success: active: false
guide: entity: remove_event: active: false
guide: entity: remove_inbox_draft_response_success: active: false
guide: entity: remove_inbox_label_response_success: active: false
guide: entity: remove_inbox_response_success: active: false
guide: entity: remove_inbox_thread_response_success: active: false
guide: entity: remove_segment_response_success: active: false
guide: entity: remove_suppression_response_success: active: false
guide: entity: remove_template_response_success: active: false
guide: entity: remove_topic_response_success: active: false
guide: entity: retrieved_attachment: active: false
guide: entity: revoke_o_auth_grant: active: false
guide: entity: rotate: active: false
guide: entity: update_api_key: active: false
guide: entity: update_broadcast_response_success: active: false
guide: entity: update_contact_property_response_success: active: false
guide: entity: update_contact_response_success: active: false
guide: entity: update_contact_topics_response_success: active: false
guide: entity: update_domain_response_success: active: false
guide: entity: update_email_option: active: false
guide: entity: update_event: active: false
guide: entity: update_inbox_draft_response_success: active: false
guide: entity: update_inbox_label_response_success: active: false
guide: entity: update_inbox_response_success: active: false
guide: entity: update_inbox_thread_response_success: active: false
guide: entity: update_segment_response_success: active: false
guide: entity: update_template_response_success: active: false
guide: entity: update_topic_response_success: active: false
guide: entity: update_webhook: active: false

# The agent settings live on their own entity below.
guide: entity: inbox: path: "/inboxes/{inbox_id}/agent": active: false


# --- Emails ---------------------------------------------------------------

guide: entity: email: path: "/emails/{email_id}": op: update: method: "PATCH"

guide: entity: email_batch: path: "/emails/batch": op: create: method: "POST"

guide: entity: email_attachment: {
  path: "/emails/{email_id}/attachments": {
    op: list: method: "GET"
    op: list: transform: res: "`body.data`"
  }
  path: "/emails/{email_id}/attachments/{attachment_id}": {
    rename: param: "attachment_id": "id"
    op: load: method: "GET"
  }
}

guide: entity: received_email_attachment: {
  path: "/emails/receiving/{email_id}/attachments": {
    op: list: method: "GET"
    op: list: transform: res: "`body.data`"
  }
  path: "/emails/receiving/{email_id}/attachments/{attachment_id}": {
    rename: param: "attachment_id": "id"
    op: load: method: "GET"
  }
}


# --- Domains and API keys -------------------------------------------------

guide: entity: domain: path: "/domains/{domain_id}": op: update: method: "PATCH"

guide: entity: api_key: {
  path: "/api-keys": op: create: method: "POST"
  path: "/api-keys/{api_key_id}": op: update: method: "PATCH"
}

guide: entity: oauth_grant: {
  path: "/oauth/grants": {
    op: list: method: "GET"
    op: list: transform: res: "`body.data`"
  }
  path: "/oauth/grants/{oauth_grant_id}": {
    rename: param: "oauth_grant_id": "id"
    op: remove: method: "DELETE"
  }
}


# --- Contacts, segments, topics, properties -------------------------------

guide: entity: audience: path: "/audiences/{id}": op: remove: method: "DELETE"

guide: entity: contact: path: "/contacts/{id}": {
  op: update: method: "PATCH"
  op: remove: method: "DELETE"
}

guide: entity: contact_import: {
  path: "/contacts/imports": {
    op: create: method: "POST"
    op: list: method: "GET"
    op: list: transform: res: "`body.data`"
  }
  path: "/contacts/imports/{id}": op: load: method: "GET"
}

guide: entity: contact_segment: {
  path: "/contacts/{contact_id}/segments": {
    op: list: method: "GET"
    op: list: transform: res: "`body.data`"
  }
  path: "/contacts/{contact_id}/segments/{segment_id}": {
    rename: param: "segment_id": "id"
    op: create: method: "POST"
    op: remove: method: "DELETE"
  }
}

guide: entity: contact_topic: path: "/contacts/{contact_id}/topics": {
  op: list: method: "GET"
  op: list: transform: res: "`body.data`"
  op: update: method: "PATCH"
}

guide: entity: contact_property: path: "/contact-properties/{id}": {
  op: update: method: "PATCH"
  op: remove: method: "DELETE"
}

guide: entity: segment: {
  path: "/segments": {
    op: create: method: "POST"
    op: list: method: "GET"
    op: list: transform: res: "`body.data`"
  }
  path: "/segments/{id}": {
    op: update: method: "PATCH"
    op: remove: method: "DELETE"
  }
}

guide: entity: segment_contact: path: "/segments/{id}/contacts": {
  rename: param: "id": "segment_id"
  op: list: method: "GET"
  op: list: transform: res: "`body.data`"
}

guide: entity: topic: {
  path: "/topics": {
    op: create: method: "POST"
    op: list: method: "GET"
    op: list: transform: res: "`body.data`"
  }
  path: "/topics/{id}": {
    op: update: method: "PATCH"
    op: remove: method: "DELETE"
  }
}


# --- Broadcasts and templates ---------------------------------------------

guide: entity: broadcast: {
  path: "/broadcasts": op: create: method: "POST"
  path: "/broadcasts/{id}": {
    op: update: method: "PATCH"
    op: remove: method: "DELETE"
  }
}

guide: entity: broadcast_recipient: path: "/broadcasts/{id}/recipients": {
  rename: param: "id": "broadcast_id"
  op: list: method: "GET"
  op: list: transform: res: "`body.data`"
}

guide: entity: broadcast_clicked_link: path: "/broadcasts/{id}/clicked-links": {
  rename: param: "id": "broadcast_id"
  op: list: method: "GET"
  op: list: transform: res: "`body.data`"
}

guide: entity: template: {
  path: "/templates": {
    op: create: method: "POST"
    op: list: method: "GET"
    op: list: transform: res: "`body.data`"
  }
  path: "/templates/{id}": {
    op: update: method: "PATCH"
    op: remove: method: "DELETE"
  }
}


# --- Suppressions and events ----------------------------------------------

guide: entity: suppression: {
  path: "/suppressions": {
    op: create: method: "POST"
    op: list: method: "GET"
    op: list: transform: res: "`body.data`"
  }
  path: "/suppressions/{suppression}": {
    rename: param: "suppression": "id"
    op: remove: method: "DELETE"
  }
}

guide: entity: suppression_batch: {
  path: "/suppressions/batch/add": {
    action: "add": {}
    op: create: method: "POST"
  }
  path: "/suppressions/batch/remove": {
    action: "remove": {}
    op: create: method: "POST"
  }
}

guide: entity: event: path: "/events/{identifier}": {
  op: update: method: "PATCH"
  op: remove: method: "DELETE"
}


# --- Automations ----------------------------------------------------------

guide: entity: automation_run: path: "/automations/{automation_id}/runs": {
  op: list: method: "GET"
  op: list: transform: res: "`body.data`"
}


# --- Webhooks -------------------------------------------------------------

guide: entity: webhook: {
  path: "/webhooks": {
    op: create: method: "POST"
    op: list: method: "GET"
    op: list: transform: res: "`body.data`"
  }
  path: "/webhooks/{webhook_id}": op: update: method: "PATCH"
  path: "/webhooks/{webhook_id}/signing-secret/rotate": {
    action: "rotate": {}
    rename: param: "webhook_id": "id"
    op: create: method: "POST"
  }
}

guide: entity: webhook_event: path: "/webhooks/{webhook_id}/events": {
  op: list: method: "GET"
  op: list: transform: res: "`body.data`"
}

guide: entity: webhook_event_attempt: path: "/webhooks/{webhook_id}/events/{event_id}/attempts": {
  op: list: method: "GET"
  op: list: transform: res: "`body.data`"
}


# --- Inboxes --------------------------------------------------------------

guide: entity: inbox: path: "/inboxes/{inbox_id}": {
  op: update: method: "PATCH"
  op: remove: method: "DELETE"
}

guide: entity: inbox_agent: path: "/inboxes/{inbox_id}/agent": {
  op: load: method: "GET"
  op: update: method: "PATCH"
}

guide: entity: inbox_draft: {
  path: "/inboxes/{inbox_id}/drafts": {
    op: create: method: "POST"
    op: list: method: "GET"
    op: list: transform: res: "`body.data`"
  }
  path: "/inboxes/{inbox_id}/drafts/{draft_id}": {
    rename: param: "draft_id": "id"
    op: load: method: "GET"
    op: update: method: "PATCH"
    op: remove: method: "DELETE"
  }
  path: "/inboxes/{inbox_id}/drafts/{draft_id}/send": {
    action: "send": {}
    rename: param: "draft_id": "id"
    op: create: method: "POST"
  }
}

guide: entity: inbox_label: {
  path: "/inboxes/{inbox_id}/labels": op: create: method: "POST"
  path: "/inboxes/{inbox_id}/labels/{label_id}": {
    rename: param: "label_id": "id"
    op: update: method: "PATCH"
    op: remove: method: "DELETE"
  }
}

guide: entity: inbox_thread: path: "/inboxes/{inbox_id}/threads/{thread_id}": {
  rename: param: "thread_id": "id"
  op: load: method: "GET"
  op: update: method: "PATCH"
  op: remove: method: "DELETE"
}

guide: entity: inbox_thread_email: {
  path: "/inboxes/{inbox_id}/threads/{thread_id}/emails/{email_id}": {
    rename: param: "email_id": "id"
    op: load: method: "GET"
  }
  path: "/inboxes/{inbox_id}/threads/{thread_id}/emails/{email_id}/reply": {
    action: "reply": {}
    rename: param: "email_id": "id"
    op: create: method: "POST"
  }
  path: "/inboxes/{inbox_id}/threads/{thread_id}/emails/{email_id}/forward": {
    action: "forward": {}
    rename: param: "email_id": "id"
    op: create: method: "POST"
  }
}
