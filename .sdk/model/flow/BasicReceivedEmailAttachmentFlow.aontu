# BasicReceivedEmailAttachmentFlow

main: kit: flow: BasicReceivedEmailAttachmentFlow:
{
  entity: "received_email_attachment",
  kind: "basic",
  name: "BasicReceivedEmailAttachmentFlow",
  step: [
    {
      m: {
        email_id: "email01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "received_email_attachment_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "received_email_attachment_ref01",
        srcdatavar: "received_email_attachment_ref01_data",
        suffix: "_dt0"
      }

      m: {
        email_id: "email01",
        id: "received_email_attachment01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-received_email_attachment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicReceivedEmailAttachmentFlow"
}